                            <TextBlock Text="{Binding SelectedCategoryScore}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding CategoryDetails}" Background="Transparent" BorderThickness="0" Margin="0,0,0,20" HorizontalContentAlignment="Stretch">
