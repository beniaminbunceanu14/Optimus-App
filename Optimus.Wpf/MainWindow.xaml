                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                            <Border Grid.Column="3" Background="#1E293B" CornerRadius="4" Padding="6,4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                                                <TextBlock Text="{Binding Penalty}" Foreground="{Binding PenaltyColor}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>

                                            <Button Grid.Column="4" Content="Fix" 
                                                    Command="{Binding DataContext.FixSingleIssueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                    CommandParameter="{Binding}"
