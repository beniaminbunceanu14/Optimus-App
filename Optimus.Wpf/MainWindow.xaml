                                                    <TextBlock Text="{Binding Impact}" Foreground="#64748B" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Time}" Foreground="#94A3B8" FontSize="10" Grid.Column="2" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. LIVE METRICS VIEW -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsMetricsVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="#1E293B" CornerRadius="12" Padding="25">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Hardware &amp; Kernel Telemetry" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Live monitoring active. Polling deep kernel drivers and hardware sensors." Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔄 Refresh Metrics" Command="{Binding RefreshMetricsCommand}" Style="{StaticResource NeonActionButton}" BorderBrush="#38BDF8" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#131B2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="CPU" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Width="50"/>
                                        <TextBlock Text="{Binding CpuTemp}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="90,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CpuLoad, StringFormat={}{0}%}" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding CpuClock}" Foreground="#38BDF8" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar Value="{Binding CpuLoad}" Maximum="100" Height="4" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#131B2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="15" Margin="4,0,4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="RAM" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Width="50"/>
                                        <TextBlock Text="3200 MHz" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" Margin="70,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RamLoad, StringFormat={}{0}%}" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding RamUsageText}" Foreground="#10B981" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar Value="{Binding RamLoad}" Maximum="100" Height="4" Background="#0F172A" Foreground="#10B981" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#131B2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="15" Margin="4,0,4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="GPU" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Width="50"/>
                                        <TextBlock Text="{Binding GpuTemp}" Foreground="#10B981" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" Margin="90,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GpuLoad, StringFormat={}{0}%}" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding GpuClock}" Foreground="#A855F7" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar Value="{Binding GpuLoad}" Maximum="100" Height="4" Background="#0F172A" Foreground="#A855F7" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#131B2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="15" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="NETWORK" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Width="60"/>
                                        <TextBlock Text="{Binding NetworkPing}" Foreground="#10B981" FontSize="11" HorizontalAlignment="Right" Margin="50,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding NetworkSpeed}" Foreground="White" FontSize="26" FontWeight="Black" Margin="0,0,0,2"/>
                                    <TextBlock Text="Packets: Stable" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar Value="25" Maximum="100" Height="4" Background="#0F172A" Foreground="#38BDF8" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="PROCESS TRUST MONITOR" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>

                                    <Grid Grid.Row="0" Margin="0,25,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Process Name" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="CPU" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="Memory" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="Trust Rating" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CpuUsage}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding RamUsage}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="3" Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RiskLevel}" Foreground="{Binding RiskColor}" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="OS KERNEL STATS" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,15"/>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="System Uptime" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SystemUptime}" Foreground="White" FontSize="14" FontFamily="Consolas" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Active Threads" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ThreadCount}" Foreground="#38BDF8" FontSize="14" FontFamily="Consolas" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Open Handles" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding HandleCount}" Foreground="#10B981" FontSize="14" FontFamily="Consolas" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Separator Background="#1E293B" Margin="0,5,0,10"/>

                                    <TextBlock Text="Telemetry Stream: Active thread polling normal [OK]" Foreground="#10B981" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Terminal / Live Audit Stream -->
            <Border Grid.Row="3" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="TRUST AUDIT STREAM:" Foreground="#10B981" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock Text=" (Confidence Layer &amp; Explain Everything Logs)" Foreground="#64748B" FontFamily="Consolas" FontSize="11" Margin="5,0,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding TerminalLogs}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#64748B" FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="[" Foreground="#475569" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Text="{Binding StatusType}" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="]" Foreground="#475569" FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Message}" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- NOU: OPTIMUS NEURAL CO-PILOT HOLOGRAPHIC OVERLAY AVANSAT -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#800B0F19" 
              Visibility="{Binding IsCoPilotOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100" UseLayoutRounding="True" SnapsToDevicePixels="True">

            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="16" 
                    Width="720" Height="530" 
                    VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                    Margin="35,0,0,95" Padding="25"
                    RenderTransformOrigin="0,1"
                    UseLayoutRounding="True" SnapsToDevicePixels="True">

                <Border.RenderTransform>
                    <ScaleTransform x:Name="HologramScale" ScaleX="0.2" ScaleY="0.2"/>
                </Border.RenderTransform>
                <Border.Opacity>0</Border.Opacity>

                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HologramScale" Storyboard.TargetProperty="ScaleX" From="0.2" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="HologramScale" Storyboard.TargetProperty="ScaleY" From="0.2" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Border.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="35" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Antet Co-Pilot cu Heartbeat Dot -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔮" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Optimus Neural Co-Pilot" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                            <!-- Status Pulsing Dot -->
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="12,0,4,0" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="Engine Live" Foreground="#10B981" FontSize="10" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding ToggleCoPilotDrawerCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Cursor="Hand"/>
                    </Grid>

                    <!-- Câmp de Input Prompt cu Placeholder Dinamic & Command Discovery Popup -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding DynamicPlaceholder}" Foreground="#475569" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>

                                <TextBox Text="{Binding CoPilotInputText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" 
                                         VerticalContentAlignment="Center"
                                         CaretBrush="White">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitCoPilotCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Button Grid.Column="1" Content="Execută" Command="{Binding SubmitCoPilotCommand}" Style="{StaticResource NeonActionButton}" Padding="18,6"/>
                            </Grid>
                        </Border>

                        <!-- Autocomplete / Command Discovery Dropdown la tasta '/' -->
                        <Popup IsOpen="{Binding IsCommandDiscoveryOpen}" PlacementTarget="{Binding ElementName=CoPilotTextBox}" StaysOpen="False" VerticalOffset="5">
                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Width="300" Padding="8">
                                <ItemsControl ItemsSource="{Binding DiscoveryCommands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Command="{Binding DataContext.SelectDiscoveryCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="#38BDF8" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,6" Cursor="Hand"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Ghid Utilizator Nou / Quick Chips -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="💡 Comenzi rapide recomandate (sau tastați /):" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔥 Temperatură" 
                                    Command="{Binding RunCoPilotQuickCommandCommand}" CommandParameter="temperatura"
                                    Style="{StaticResource ProfileChipStyle}" Foreground="#F59E0B" BorderBrush="#F59E0B" Padding="8,4" Margin="0,0,6,0"/>

                            <Button Content="🧹 Curăță Junk" 
                                    Command="{Binding RunCoPilotQuickCommandCommand}" CommandParameter="curatare"
                                    Style="{StaticResource ProfileChipStyle}" Foreground="#38BDF8" BorderBrush="#38BDF8" Padding="8,4" Margin="0,0,6,0"/>

                            <Button Content="🌐 Reset DNS" 
                                    Command="{Binding RunCoPilotQuickCommandCommand}" CommandParameter="retea"
                                    Style="{StaticResource ProfileChipStyle}" Foreground="#10B981" BorderBrush="#10B981" Padding="8,4" Margin="0,0,6,0"/>

                            <Button Content="⚡ Gaming Mode" 
                                    Command="{Binding RunCoPilotQuickCommandCommand}" CommandParameter="gaming"
                                    Style="{StaticResource ProfileChipStyle}" Foreground="#C084FC" BorderBrush="#C084FC" Padding="8,4"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Panou de Răspuns Structurat cu Typewriter Effect -->
                    <Border Grid.Row="4" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,6,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="DIAGNOSTIC &amp; RĂSPUNS KERNEL AI:" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Kernel Core v4.2 Local Engine [ACTIVE]" Foreground="#10B981" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="130">
                                <TextBlock Text="{Binding CoPilotAIResponse}" Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" FontFamily="Consolas" LineHeight="18"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Card Proactiv / Pre-Flight Check pentru Planul Autonom -->
                    <Border Grid.Row="5" Background="#064E3B" BorderBrush="#059669" BorderThickness="1.2" CornerRadius="8" Padding="12">
                        <Border.Effect>
                            <DropShadowEffect x:Name="CardGlow" Color="#10B981" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="BlurRadius" From="8" To="22" Duration="0:0:1.5"/>
                                        <DoubleAnimation Storyboard.TargetName="CardGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.9" Duration="0:0:1.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProactiveAlertTitle}" Foreground="#34D399" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding ProactiveAlertDescription}" Foreground="#A7F3D0" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Examenează &amp; Execută" Command="{Binding TriggerPreflightCheckCommand}" Style="{StaticResource ProfileChipStyle}" Foreground="#34D399" BorderBrush="#059669" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Pre-Flight Checklist Expandabil -->
                            <StackPanel Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsPreflightVisible, Converter={StaticResource BoolToVis}}">
                                <Separator Background="#059669" Margin="0,0,0,8"/>
                                <TextBlock Text="PRE-FLIGHT CHECKLIST (Acțiuni planificate):" Foreground="#34D399" FontWeight="Bold" FontSize="10" Margin="0,0,0,4"/>
                                <TextBlock Text=" • Pasul 1: Ștergere fișiere temporare din %TEMP%\n • Pasul 2: Golire cache DNS local\n • Pasul 3: Optimizare timpi de răspuns registri" Foreground="#A7F3D0" FontSize="11" FontFamily="Consolas" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Anulează" Command="{Binding TriggerPreflightCheckCommand}" Style="{StaticResource ProfileChipStyle}" Foreground="#94A3B8" BorderBrush="#334155" Padding="10,4" Margin="0,0,8,0"/>
                                    <Button Content="Confirmă &amp; Execută ✔" Command="{Binding ConfirmAndExecuteAutonomousPlanCommand}" Style="{StaticResource ProfileChipStyle}" Foreground="White" Background="#059669" BorderBrush="#10B981" Padding="12,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>