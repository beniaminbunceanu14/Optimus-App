                                                    Style="{StaticResource ProfileChipStyle}" Foreground="#10B981" BorderBrush="#10B981" Padding="12,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#0B0F19" CornerRadius="8" Padding="15">
