                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. RECOMMENDATIONS VIEW -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsRecommendationsVisible, Converter={StaticResource BoolToVis}}">
